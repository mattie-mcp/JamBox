SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
SPOTIFY_DEVICE_NAME=raspotify
DATABASE_URL=sqlite:///jambox.db

# Hard volume cap (percent, 0-100). Only set here; no API can change it.
# JAMBOX_MAX_VOLUME_PERCENT=60
# Folder of the built parent UI. Default: <repo>/frontend/out
# JAMBOX_UI_DIR=
# Comma-separated CORS origins, for local dev only (e.g. http://localhost:3000). Leave empty on the box.
# JAMBOX_DEV_CORS_ORIGINS=
