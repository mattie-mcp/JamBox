[Unit]
Description=JamBox API Server
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/src/JamBox/backend
EnvironmentFile=/home/admin/src/JamBox/backend/.env
Environment=PATH=/home/admin/src/JamBox/backend/.venv/bin:/usr/bin
ExecStart=/home/admin/src/JamBox/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
