[Unit]
Description=JamBox Web Frontend
After=music-box-api.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/src/JamBox/frontend
Environment=PATH=/usr/local/bin:/usr/bin
Environment=NEXT_PUBLIC_API_URL=http://pi-3b.local:8000
Environment=PORT=3000
ExecStart=/usr/bin/npx next start --port 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
