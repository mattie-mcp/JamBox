[Unit]
Description=JamBox NFC Daemon
After=jambox-api.service
Requires=jambox-api.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/admin/src/JamBox/backend
EnvironmentFile=/home/admin/src/JamBox/backend/.env
Environment=PATH=/home/admin/src/JamBox/backend/.venv/bin:/usr/bin
ExecStart=/home/admin/src/JamBox/backend/.venv/bin/python -m app.nfc_daemon
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
