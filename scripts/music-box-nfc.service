[Unit]
Description=JamBox NFC Daemon
After=music-box-api.service
Requires=music-box-api.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/music-box/backend
Environment=PATH=/home/pi/music-box/backend/.venv/bin:/usr/bin
ExecStart=/home/pi/music-box/backend/.venv/bin/python -m app.nfc_daemon
Restart=always

[Install]
WantedBy=multi-user.target
